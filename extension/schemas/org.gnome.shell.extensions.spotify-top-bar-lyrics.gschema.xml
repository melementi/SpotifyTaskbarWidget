<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.spotify-top-bar-lyrics.PanelPosition">
    <value nick="left" value="0"/>
    <value nick="center" value="1"/>
    <value nick="right" value="2"/>
  </enum>
  <schema id="org.gnome.shell.extensions.spotify-top-bar-lyrics"
          path="/org/gnome/shell/extensions/spotify-top-bar-lyrics/">
    <key name="lyric-offset-ms" type="i">
      <default>0</default>
      <range min="-10000" max="10000"/>
      <summary>Lyric offset in milliseconds</summary>
      <description>Positive values show lyrics earlier, negative values later.</description>
    </key>
    <key name="panel-position" enum="org.gnome.shell.extensions.spotify-top-bar-lyrics.PanelPosition">
      <default>'left'</default>
      <summary>Top bar section</summary>
      <description>Which part of the top bar shows the song: left, center or right.</description>
    </key>
    <key name="panel-index" type="i">
      <default>-1</default>
      <range min="-1" max="20"/>
      <summary>Place within the section</summary>
      <description>0 puts the song first in its section; -1 puts it last.</description>
    </key>
    <key name="title-max-width" type="i">
      <default>200</default>
      <range min="40" max="1000"/>
      <summary>Widest song title in pixels</summary>
      <description>Longer titles end in an ellipsis.</description>
    </key>
    <key name="lyric-max-width" type="i">
      <default>420</default>
      <range min="80" max="2000"/>
      <summary>Widest lyric line in pixels</summary>
      <description>Longer lines end in an ellipsis.</description>
    </key>
  </schema>
</schemalist>
