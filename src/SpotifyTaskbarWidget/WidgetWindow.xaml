<Window x:Class="SpotifyTaskbarWidget.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpotifyTaskbarWidget"
        Width="620" Height="48"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Cursor="Hand" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Width="32" Height="32" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
            <Border.Background>
                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
            </Border.Background>
        </Border>

        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ArtistText" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel x:Name="LyricsPanel" Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="PreviousText" FontSize="11" Height="14" Opacity="0.45"
                       LineHeight="14" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="CurrentText" FontSize="13" Height="18" FontWeight="SemiBold"
                       LineHeight="18" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="NextText" FontSize="11" Height="14" Opacity="0.45"
                       LineHeight="14" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</Window>
